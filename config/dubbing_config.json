{
  "version": 1,
  "enabled": false,
  "runtime_python": "",
  "tts_backend": "voxcpm2",
  "voxcpm_model_path": "models/VoxCPM2",
  "device": "cuda",
  "allow_cpu": false,
  "minimum_free_gb": 2,
  "demucs": {
    "model": "htdemucs",
    "sample_rate": 48000,
    "channels": 2
  },
  "reference": {
    "duration_seconds": 8.0,
    "minimum_seconds": 5.0,
    "maximum_seconds": 10.0,
    "skip_intro_seconds": 3.0,
    "maximum_continuity_gap_seconds": 0.6,
    "use_prompt_transcript": true
  },
  "tts": {
    "cfg_value": 2.0,
    "inference_timesteps": 10,
    "normalize": true,
    "denoise": false,
    "retry_badcase": true,
    "retry_badcase_max_times": 2
  },
  "timing": {
    "min_gap_ms": 200,
    "max_extension_ms": 1500,
    "direct_accept_ratio": 1.08,
    "max_stretch_ratio": 1.15,
    "duration_retry_enabled": true,
    "duration_retry_max_times": 1,
    "regional_scheduling_enabled": true,
    "trim_silence_enabled": true,
    "silence_threshold_db": -45.0,
    "silence_relative_db": -35.0,
    "silence_padding_ms": 40,
    "region_max_gap_ms": 650,
    "region_internal_gap_ms": 60,
    "region_boundary_gap_ms": 80,
    "max_alignment_shift_ms": 1500,
    "overlap_tolerance_ms": 20
  },
  "mix": {
    "background_duck_db": 6.0,
    "duck_attack_ms": 40,
    "duck_release_ms": 250,
    "sample_rate": 48000,
    "limiter": 0.95
  },
  "loudness": {
    "enabled": true,
    "voice_target_lufs": -18.0,
    "voice_true_peak_db": -2.0,
    "final_target_lufs": -14.0,
    "final_true_peak_db": -1.0,
    "final_lra": 11.0
  },
  "performance": {
    "keep_voxcpm_warm": false,
    "worker_idle_timeout_seconds": 45
  }
}
